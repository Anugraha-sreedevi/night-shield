# Twilio SMS Gateway Configuration for NightShield
# Get these credentials from your Twilio Console: https://console.twilio.com/
# Ensure your Twilio phone number has active SMS capability.

TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional: NightShield server port (default 5000)
PORT=5000
